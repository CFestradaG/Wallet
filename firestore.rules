rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPeriodId(pid) {
      return pid is string && pid.size() >= 7 && pid.size() <= 20 && pid.matches('^(period_)?[0-9]{4}[_-][0-9]{2}$');
    }

    function isValidCurrency(curr) {
      return curr is string && curr.size() == 3 && curr in ['GTQ', 'USD', 'EUR', 'MXN'];
    }

    function userExists(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'defaultCurrency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'displayName', 'defaultCurrency',
          'startDayOfMonth', 'enableSplitPeriod', 'midMonthDay',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isValidCurrency(data.defaultCurrency)
        && (!('startDayOfMonth' in data) || (data.startDayOfMonth is number && data.startDayOfMonth >= 1 && data.startDayOfMonth <= 31))
        && (!('enableSplitPeriod' in data) || data.enableSplitPeriod is bool)
        && (!('midMonthDay' in data) || (data.midMonthDay is number && data.midMonthDay >= 1 && data.midMonthDay <= 31))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'balance', 'currency', 'colorHex', 'iconName', 'subtitle', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'type', 'balance', 'currentBalance', 'currency', 'colorHex', 'iconName', 'subtitle', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && (!('id' in data) || isValidId(data.id))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.type is string && data.type.size() <= 20 && data.type in ['cash', 'bank', 'credit_card', 'savings', 'investment']
        && data.balance is number
        && (!('currentBalance' in data) || data.currentBalance is number)
        && isValidCurrency(data.currency)
        && data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 9
        && data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 40
        && data.subtitle is string && data.subtitle.size() >= 0 && data.subtitle.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'userId', 'accountId', 'accountName', 'categoryId', 'categoryName',
          'categoryIcon', 'categoryColor', 'type', 'amount', 'currency',
          'note', 'dateIso', 'yearMonth', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'accountId', 'accountName', 'toAccountId', 'toAccountName',
          'categoryId', 'categoryName', 'categoryIcon', 'categoryColor',
          'type', 'amount', 'currency', 'note', 'dateIso',
          'yearMonth', 'periodId', 'subcategory', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && (!('id' in data) || isValidId(data.id))
        && isValidId(data.accountId)
        && data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 80
        && (!('toAccountId' in data) || isValidId(data.toAccountId))
        && (!('toAccountName' in data) || (data.toAccountName is string && data.toAccountName.size() >= 1 && data.toAccountName.size() <= 80))
        && isValidId(data.categoryId)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80
        && data.categoryIcon is string && data.categoryIcon.size() >= 1 && data.categoryIcon.size() <= 40
        && data.categoryColor is string && data.categoryColor.size() >= 4 && data.categoryColor.size() <= 9
        && data.type is string && data.type.size() <= 15 && data.type in ['income', 'expense', 'transfer']
        && data.amount is number && data.amount >= 0
        && isValidCurrency(data.currency)
        && data.note is string && data.note.size() >= 0 && data.note.size() <= 200
        && data.dateIso is string && data.dateIso.size() >= 10 && data.dateIso.size() <= 40
        && isValidPeriodId(data.yearMonth)
        && (!('periodId' in data) || isValidPeriodId(data.periodId))
        && (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['userId', 'name', 'subtitle', 'iconName', 'colorHex', 'type', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'subtitle', 'iconName', 'colorHex', 'type', 'subcategories', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && (!('id' in data) || isValidId(data.id))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.subtitle is string && data.subtitle.size() >= 0 && data.subtitle.size() <= 120
        && data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 40
        && data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 9
        && data.type is string && data.type.size() <= 15 && data.type in ['income', 'expense']
        && (!('subcategories' in data) || data.subcategories is list)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudget(data) {
      return data.keys().hasAll([
          'userId', 'name', 'categoryId', 'limitAmount', 'spentAmount',
          'currency', 'period', 'iconName', 'colorHex', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'categoryId', 'limitAmount', 'spentAmount',
          'currency', 'period', 'iconName', 'colorHex', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && (!('id' in data) || isValidId(data.id))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidId(data.categoryId)
        && data.limitAmount is number && data.limitAmount > 0
        && data.spentAmount is number && data.spentAmount >= 0
        && isValidCurrency(data.currency)
        && isValidPeriodId(data.period)
        && data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 40
        && data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 9
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMonthlySummary(data) {
      return data.keys().hasAll([
          'userId', 'yearMonth', 'totalIncome', 'totalExpense',
          'netCashFlow', 'savingsRate', 'currency', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'yearMonth', 'periodId', 'totalIncome', 'totalExpense',
          'netCashFlow', 'savingsRate', 'currency', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && (!('id' in data) || isValidId(data.id))
        && isValidPeriodId(data.yearMonth)
        && (!('periodId' in data) || isValidPeriodId(data.periodId))
        && data.totalIncome is number && data.totalIncome >= 0
        && data.totalExpense is number && data.totalExpense >= 0
        && data.netCashFlow is number
        && data.savingsRate is number
        && isValidCurrency(data.currency)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'defaultCurrency',
          'startDayOfMonth', 'enableSplitPeriod', 'midMonthDay',
          'updatedAt'
        ]);

      // Subcollection: /users/{userId}/accounts/{accountId}
      match /accounts/{accountId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(accountId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(accountId)
          && isValidAccount(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(accountId)
          && isValidAccount(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'balance', 'currentBalance', 'currency', 'colorHex', 'iconName', 'subtitle', 'updatedAt'])
          && userExists(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(accountId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/transactions/{transactionId}
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'accountId', 'accountName', 'toAccountId', 'toAccountName',
            'categoryId', 'categoryName', 'categoryIcon', 'categoryColor',
            'type', 'amount', 'currency', 'note', 'dateIso',
            'yearMonth', 'periodId', 'subcategory', 'updatedAt'
          ])
          && userExists(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/categories/{categoryId}
      match /categories/{categoryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(categoryId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(categoryId)
          && isValidCategory(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(categoryId)
          && isValidCategory(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'subtitle', 'iconName', 'colorHex', 'type', 'subcategories', 'updatedAt'])
          && userExists(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(categoryId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/budgets/{budgetId}
      match /budgets/{budgetId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(budgetId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(budgetId)
          && isValidBudget(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(budgetId)
          && isValidBudget(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'categoryId', 'limitAmount', 'spentAmount', 'currency', 'period', 'iconName', 'colorHex', 'updatedAt'])
          && userExists(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(budgetId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/summaries/{periodId}
      match /summaries/{periodId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidPeriodId(periodId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidPeriodId(periodId)
          && isValidMonthlySummary(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidPeriodId(periodId)
          && isValidMonthlySummary(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['yearMonth', 'periodId', 'totalIncome', 'totalExpense', 'netCashFlow', 'savingsRate', 'currency', 'updatedAt'])
          && userExists(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidPeriodId(periodId) && userExists(userId);
      }
    }
  }
}
