{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil principal del usuario propietario de la billetera",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID de Firebase Auth del propietario",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Nombre visible del usuario",
          "minLength": 1,
          "maxLength": 100
        },
        "defaultCurrency": {
          "type": "string",
          "description": "Moneda base ISO (ej. GTQ, USD)",
          "enum": ["GTQ", "USD", "EUR", "MXN"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp de creación del perfil"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp de última actualización"
        }
      },
      "required": ["userId", "displayName", "defaultCurrency", "createdAt", "updatedAt"]
    },
    "Account": {
      "title": "Account",
      "description": "Cuenta bancaria, efectivo o tarjeta de crédito del usuario",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": ["cash", "bank", "credit_card", "savings", "investment"]
        },
        "balance": {
          "type": "number",
          "description": "Saldo actual de la cuenta en GTQ"
        },
        "currency": {
          "type": "string",
          "enum": ["GTQ", "USD", "EUR", "MXN"]
        },
        "colorHex": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9
        },
        "iconName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "subtitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "name", "type", "balance", "currency", "colorHex", "iconName", "subtitle", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Registro individual de ingreso, gasto o transferencia",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "categoryIcon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "categoryColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense", "transfer"]
        },
        "amount": {
          "type": "number",
          "description": "Monto positivo de la transacción"
        },
        "currency": {
          "type": "string",
          "enum": ["GTQ", "USD", "EUR", "MXN"]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dateIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "yearMonth": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}_[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "accountId",
        "accountName",
        "categoryId",
        "categoryName",
        "categoryIcon",
        "categoryColor",
        "type",
        "amount",
        "currency",
        "note",
        "dateIso",
        "yearMonth",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Categoría personalizada o predeterminada de ingresos/gastos",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "iconName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "colorHex": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "name", "subtitle", "iconName", "colorHex", "type", "createdAt", "updatedAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Presupuesto mensual con tope de gasto por categoría",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "limitAmount": {
          "type": "number"
        },
        "spentAmount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["GTQ", "USD", "EUR", "MXN"]
        },
        "period": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}_[0-9]{2}$"
        },
        "iconName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "colorHex": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "categoryId",
        "limitAmount",
        "spentAmount",
        "currency",
        "period",
        "iconName",
        "colorHex",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlySummary": {
      "title": "MonthlySummary",
      "description": "Resumen consolidado mensual (/users/{userId}/summaries/{year_month})",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "yearMonth": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}_[0-9]{2}$"
        },
        "totalIncome": {
          "type": "number"
        },
        "totalExpense": {
          "type": "number"
        },
        "netCashFlow": {
          "type": "number"
        },
        "savingsRate": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["GTQ", "USD", "EUR", "MXN"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "yearMonth",
        "totalIncome",
        "totalExpense",
        "netCashFlow",
        "savingsRate",
        "currency",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Documento raíz del perfil del usuario"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Subcolección de cuentas bancarias, efectivo y tarjetas"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Subcolección de transacciones de ingresos, gastos y transferencias"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Subcolección de categorías personalizadas por usuario"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "Subcolección de presupuestos mensuales por usuario"
    },
    "/users/{userId}/summaries/{year_month}": {
      "schema": { "$ref": "#/entities/MonthlySummary" },
      "description": "Subcolección de resúmenes agregados por año y mes (YYYY_MM)"
    }
  }
}
